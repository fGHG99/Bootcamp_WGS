<div class="contact-page">
  <%- include('./utils/contactStyle.ejs') %>
  <button class="btn add-btn" onclick="openModal('addModal')">
    Add New Contact
  </button>
  <%- include('./utils/addModal.ejs') %>
  <%- include('./utils/contactSc.ejs') %>
  <h1>Contact Management</h1>
  <%- include('./utils/notification.ejs') %> <% if (contact.length > 0) { %>
  <table>
    <thead>
      <tr>
        <th>No</th>
        <th>Name</th>
        <th>Email</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% contact.forEach((c, i) => { %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= c.name %></td>
        <td><%= c.email %></td>
        <td>
          <button
            class="btn detail-btn"
            onclick="showDetail('<%= c.id %>', '<%= c.name %>', '<%= c.email %>', '<%= c.mobile %>')"
            data-bs-toggle="modal"
            data-bs-target="#detailModal"
          >
            Detail
          </button>
          <button
            class="btn edit-btn"
            onclick="editContact('<%= c.id %>','<%= c.name %>', '<%= c.email %>', '<%= c.mobile %>')"
          >
            Edit
          </button>
          <button
            class="btn delete-btn"
            onclick="deleteContact('<%= c.id %>')"
            data-bs-toggle=""
          >
            Delete
          </button>
        </td>
      </tr>

      <%- include('./utils/deleteModal.ejs') %> <%-
      include('./utils/detailModal.ejs') %> <% }) %> <%-
      include('./utils/editModal.ejs') %>
    </tbody>
  </table>
  <% } else { %>
  <p>No contact information available.</p>
  <% } %> <%- include('./utils/contactSc.ejs') %>
</div>
