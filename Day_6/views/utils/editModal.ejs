<div id="editModal" class="modal <%= showEditModal ? 'show' : '' %>">
  <div class="modal-content">
    <span class="close" onclick="closeModal('editModal')">&times;</span>
    <h2>Edit Contact</h2>

    <form id="editForm" method="POST">
      <input type="hidden" id="edit-id" name="id" value="<%= old && old.id ? old.id : '' %>">

      <div class="form-group">
        <label for="edit-name">Name</label>
        <input 
          type="text" 
          id="edit-name" 
          name="name" 
          placeholder="Name"
          required
          value="<%= old && old.name ? old.name : '' %>"
        >
        <% if (errors && errors.name) { %>
          <div class="error-msg"><%= errors.name %></div>
        <% } %>
      </div>

      <div class="form-group">
        <label for="edit-email">Email</label>
        <input 
          type="email" 
          id="edit-email" 
          name="email" 
          placeholder="Email"
          required
          value="<%= old && old.email ? old.email : '' %>"
        >
        <% if (errors && errors.email) { %>
          <div class="error-msg"><%= errors.email %></div>
        <% } %>
      </div>

      <div class="form-group">
        <label for="edit-mobile">Mobile</label>
        <input 
          type="text" 
          id="edit-mobile" 
          name="mobile" 
          placeholder="Mobile"
          required
          value="<%= old && old.mobile ? old.mobile : '' %>"
        >
        <% if (errors && errors.mobile) { %>
          <div class="error-msg"><%= errors.mobile %></div>
        <% } %>
      </div>

      <button type="submit">Save</button>
    </form>
  </div>
</div>

<script>
       if (showEditModal) { 
    document.getElementById("editModal").style.display = "block";
   }
</script>
