<div id="addModal" class="modal <%= showAddModal ? 'show' : '' %>">
  <div class="modal-content">
    <span class="close" onclick="closeModal('addModal')">&times;</span>
    <h2>Add New Contact</h2>
    <form action="/contact/input" method="POST">
      <div class="form-group">
        <label for="name">Name</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          placeholder="Enter name" 
          required 
          value="<%= old && old.name ? old.name : '' %>"
        >
        <% if (errors && errors.name) { %>
          <div class="error-msg"><%= errors.name %></div>
        <% } %>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          placeholder="Enter email" 
          required
          value="<%= old && old.email ? old.email : '' %>"
        >
        <% if (errors && errors.email) { %>
          <div class="error-msg"><%= errors.email %></div>
        <% } %>
      </div>

      <div class="form-group">
        <label for="mobile">Mobile</label>
        <input 
          type="tel" 
          id="mobile" 
          name="mobile" 
          placeholder="Enter mobile number" 
          required
          value="<%= old && old.mobile ? old.mobile : '' %>"
        >
        <% if (errors && errors.mobile) { %>
          <div class="error-msg"><%= errors.mobile %></div>
        <% } %>
      </div>

      <button type="submit" class="submit-btn">Save Contact</button>
    </form>
  </div>
</div>

<script>
       if (showAddModal) { 
    document.getElementById("addModal").style.display = "block";
   }
</script>